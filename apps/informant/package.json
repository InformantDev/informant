{
  "name": "@informant/cli",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "module": "src/cli.ts",
  "bin": {
    "informant": "./dist/informant.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun src/cli.ts",
    "test": "bun test src",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/cli.ts --target=bun --outfile=dist/informant.js",
    "build:binary": "bun build src/cli.ts --compile --outfile=dist/informant"
  },
  "dependencies": {
    "@clack/core": "1.4.3",
    "@clack/prompts": "^1.5.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
