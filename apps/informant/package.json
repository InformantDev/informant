{
  "name": "@informant/cli",
  "version": "0.1.7",
  "private": false,
  "type": "module",
  "module": "src/cli.ts",
  "bin": {
    "informant": "./dist/informant.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun src/cli.ts",
    "test": "bun test src",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/cli.ts --target=bun --outfile=dist/informant.js",
    "build:binary": "bun build src/cli.ts --compile --outfile=dist/informant",
    "build:binary:darwin-arm64": "bun build src/cli.ts --compile --minify --target=bun-darwin-arm64 --outfile=dist/informant-darwin-arm64",
    "build:binary:darwin-x64": "bun build src/cli.ts --compile --minify --target=bun-darwin-x64 --outfile=dist/informant-darwin-x64",
    "build:binary:linux-x64": "bun build src/cli.ts --compile --minify --target=bun-linux-x64 --outfile=dist/informant-linux-x64",
    "build:binary:linux-arm64": "bun build src/cli.ts --compile --minify --target=bun-linux-arm64 --outfile=dist/informant-linux-arm64",
    "build:all": "bun run build:binary:darwin-arm64 && bun run build:binary:darwin-x64 && bun run build:binary:linux-x64 && bun run build:binary:linux-arm64"
  },
  "dependencies": {
    "@clack/core": "1.4.3",
    "@clack/prompts": "^1.5.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
