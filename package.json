{
  "name": "informant-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:binary": "bun run --cwd apps/informant build:binary",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "dev": "bun run --cwd apps/informant dev",
    "docs:dev": "bun run --cwd apps/web dev",
    "test": "turbo run test --filter=@informant/cli",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/bun": "latest",
    "turbo": "2.10.8",
    "typescript": "^5"
  }
}
