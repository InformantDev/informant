{
  "name": "informant-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "build:binary": "bun run --cwd apps/informant build:binary",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "dev": "bun run --cwd apps/informant dev",
    "docs:dev": "bun run --cwd apps/web dev",
    "test": "bun run --cwd apps/informant test",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@ampcode/sdk": "0.1.0-20260724142523-g5b0a5e3",
    "@biomejs/biome": "^2.4.16",
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
