# Developer-local Turbo runs can share the Informant-owned Linux/root cache used by container jobs.
# Copy this file to .env; Bun loads it automatically. Keep the Linux/root shared-cache ID.
TURBO_CACHE_DIR=${HOME}/.local/share/informant/caches/linux/shared/f69aad2dcd2590c7

# Match the retention and size limits configured for Informant container jobs.
TURBO_CACHE_MAX_AGE=14d
TURBO_CACHE_MAX_SIZE=10GB
